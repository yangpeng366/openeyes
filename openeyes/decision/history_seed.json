{
  "version": 2,
  "note": "Labelled history for the local XERJ judge. One document per example. The node retrieves neighbours by the question text and votes on their labels, so a document has to carry the goal phrasing it should match AND the option names it must be told apart from - hence the text convention '<goal> | <option> | <distractors>'. Each action appears twice per language, and goal and option share a language: the first version mixed an English goal with a Chinese option, which matched neither a Chinese nor an English question except through the option token.",
  "fields": {
    "label": "the option name the vote should return",
    "text": "<goal> | <option> | <distractor>..."
  },
